{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug pytest - single test",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/unit/test_file_manager.py::TestFileManager::test_cleanup_expired_backups_logs_errors",
        "-s",
        "-q"
      ],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Attach (Remote debugpy)",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      }
    }
  ]
}
